+++ work/staff_server/Caddyfile.attacker	2026-11-24 14:43:56.149617948 +0000
@@ -38,3 +38,27 @@
 		file_server
 	}
 }
+
+# Captive-portal part: a fake "CSL Cafe Free Wi-Fi" sign-in page on port 8080.
+# On the Pineapple, one non-persistent iptables rule sends the victim's plain
+# HTTP (port 80, any site) here; HTTPS is untouched. Every GET gets the sign-in
+# page, every POST gets "You're connected". Students read the POSTed email and
+# password in Wireshark. Port 8080 keeps it apart from the stretch task's fake
+# shop on port 80. no-store: once the rule is removed, the victim's browser
+# must not keep showing a cached copy of the page.
+http://:8080 {
+	header Cache-Control "no-store"
+	root * C:/csl-lab/sites/cafe-portal
+	@login method POST
+	handle @login {
+		header Content-Type "text/html; charset=utf-8"
+		respond `<!doctype html><html><head><meta charset="utf-8"><title>CSL Cafe Free Wi-Fi</title><link rel="stylesheet" href="/style.css"></head><body><header><h1>CSL Cafe Free Wi-Fi</h1></header><main><h2>You're connected</h2><p>Enjoy your coffee!</p></main></body></html>` 200
+	}
+	handle /style.css {
+		file_server
+	}
+	handle {
+		rewrite * /portal.html
+		file_server
+	}
+}
